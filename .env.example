# -------------------------
# App
# -------------------------
PROJECT_NAME=RAG Researcher API
VERSION=0.1.0
API_PREFIX=/api

# -------------------------
# CORS
# -------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------
# Database
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=my_rag_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# -------------------------
# Embeddings
# -------------------------
TEI_URL=http://localhost:8080
TEI_MAX_BATCH=8
TEI_MODE=passage
EMBEDDING_DIM=384

# -------------------------
# LLM / Models
# -------------------------
# Set to "ollama" (default) or "kaggle" to choose the generation backend
LLM_PROVIDER=ollama
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.2

# Kaggle LitServe settings (used when LLM_PROVIDER=kaggle)
# Update KAGGLE_LLM_URL each Kaggle session with the new tunnel URL
KAGGLE_LLM_URL=
KAGGLE_LLM_API_KEY=
KAGGLE_LLM_MAX_TOKENS=1024
KAGGLE_LLM_TEMPERATURE=0.2

# Groq settings (used for chat title generation)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_TITLE_MODEL=llama-3.1-8b-instant
GROQ_TITLE_TEMPERATURE=0.2
GROQ_TITLE_MAX_TOKENS=24
GROQ_TITLE_TIMEOUT=10

# -------------------------
# Auth
# -------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# -------------------------
# Rate Limiting
# -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLEANUP_INTERVAL=300

# -------------------------
# Redis Cache
# -------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_EMBEDDINGS=3600
CACHE_TTL_LLM=1800
CACHE_KEY_PREFIX=rag_cache

# -------------------------
# File Uploads
# -------------------------
UPLOAD_DIR=./uploads

# -------------------------
# Observability
# -------------------------
# Metrics
ENABLE_METRICS=true
METRICS_SLOW_QUERY_THRESHOLD_MS=100

# Tracing (OpenTelemetry)
ENABLE_TRACING=true
OTEL_SERVICE_NAME=rag-researcher
OTEL_EXPORTER_TYPE=otlp
OTLP_ENDPOINT=http://tempo:4317
OTEL_TRACE_SAMPLE_RATE=1.0

# Logging (Loki)
LOKI_ENABLED=true
LOKI_ENDPOINT=http://loki:3100

# -------------------------
# Grafana Dashboards
# -------------------------
# Access Grafana at: http://localhost:3000
# Default credentials: admin / admin
