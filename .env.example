# -------------------------
# App
# -------------------------
PROJECT_NAME=RAG Researcher API
VERSION=0.1.0
API_PREFIX=/api

# -------------------------
# CORS
# -------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------
# Database
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=my_rag_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# -------------------------
# Embeddings
# -------------------------
TEI_URL=http://localhost:8080
TEI_MAX_BATCH=8
TEI_MODE=passage
EMBEDDING_DIM=384

# -------------------------
# LLM / Models
# -------------------------
OLLAMA_MODEL=gemma3:1b
OLLAMA_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# -------------------------
# Auth
# -------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# -------------------------
# Rate Limiting
# -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CLEANUP_INTERVAL=300

# -------------------------
# Redis Cache
# -------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_EMBEDDINGS=3600
CACHE_TTL_LLM=1800
CACHE_KEY_PREFIX=rag_cache

# -------------------------
# File Uploads
# -------------------------
UPLOAD_DIR=./uploads
